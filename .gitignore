# ─────────────────────────────────────────────
#  SAPA Gampong — monorepo .gitignore
# ─────────────────────────────────────────────

# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Browser automation artifacts (snapshots, console logs, screenshots)
.playwright-mcp/

# Env / secrets (NEVER commit)
.env
.env.*
!.env.example
!.env.test.example
*.pem
*.key

# Local machine-specific docker overrides (e.g. port remaps)
docker-compose.override.yml

# ── Node / backend / dashboard ──
node_modules/
dist/
build/
coverage/
.npm/
npm-debug.log*
yarn-error.log*
.eslintcache
.vite/
*.tsbuildinfo

# Prisma local db (keep migrations, ignore local data)
*.db
*.sqlite

# Uploaded files / generated PDFs (local storage)
backend/storage/
storage/

# ── Flutter / mobile ──
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/**/generated_plugin_registrant.*
mobile/**/*.g.dart
mobile/**/*.freezed.dart
mobile/.metadata

# Android
mobile/android/**/gradle-wrapper.jar
mobile/android/.gradle/
mobile/android/captures/
mobile/android/local.properties
mobile/android/**/GeneratedPluginRegistrant.java
mobile/android/key.properties
*.keystore
*.jks

# iOS
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/**/*.mode1v3
mobile/**/*.xcworkspace/xcuserdata/
