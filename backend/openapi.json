{
  "openapi": "3.1.0",
  "info": {
    "title": "SAPA Gampong API",
    "version": "0.1.0",
    "description": "API for Gampong Blang services: letter requests, authenticity verification, village content, and citizen feedback. Log in via POST /api/auth/login, copy the returned token, then use Authorize to try protected admin endpoints."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Active server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service status endpoints"
    },
    {
      "name": "Auth",
      "description": "Admin authentication endpoints"
    },
    {
      "name": "Letter Types",
      "description": "Letter catalog and dynamic form schemas"
    },
    {
      "name": "Requests",
      "description": "Public request submission and status tracking"
    },
    {
      "name": "Uploads",
      "description": "Upload endpoints and signed file access"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "RATE_LIMITED",
                  "PAYLOAD_TOO_LARGE",
                  "SERVER_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ],
        "description": "Standard envelope used by every non-2xx error response.",
        "example": {
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Data yang dikirim tidak valid",
            "fields": {
              "nik": "harus 16 digit"
            }
          }
        }
      },
      "LoginBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@gampongblang.id"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "kata-sandi-anda"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AdminUserPublic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "approver"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AdminUserPublic"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "LetterField": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "date",
              "time",
              "year",
              "number",
              "nik",
              "phone",
              "email",
              "enum"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "key",
          "label",
          "type",
          "required"
        ]
      },
      "LetterType": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "L6",
              "L7",
              "L8",
              "L9",
              "L10"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "subject_is_applicant": {
            "type": "boolean"
          },
          "required_attachments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signatory": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LetterField"
            }
          }
        },
        "required": [
          "code",
          "name",
          "description",
          "subject_is_applicant",
          "required_attachments",
          "signatory",
          "fields"
        ]
      },
      "LetterTypeListResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/LetterType"
        }
      },
      "CreateRequestBody": {
        "type": "object",
        "properties": {
          "letter_type": {
            "type": "string",
            "enum": [
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "L6",
              "L7",
              "L8",
              "L9",
              "L10"
            ]
          },
          "applicant_name": {
            "type": "string",
            "minLength": 1
          },
          "applicant_email": {
            "type": "string",
            "format": "email"
          },
          "applicant_phone": {
            "type": "string"
          },
          "keperluan": {
            "type": "string"
          },
          "subject_data": {
            "type": "object",
            "additionalProperties": {}
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "KTP",
                    "KK",
                    "other",
                    "photo",
                    "document"
                  ]
                }
              },
              "required": [
                "file_id",
                "kind"
              ]
            }
          }
        },
        "required": [
          "letter_type",
          "applicant_name",
          "applicant_email",
          "subject_data",
          "attachments"
        ]
      },
      "CreateRequestResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reference_code": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUBMITTED"
            ]
          }
        },
        "required": [
          "id",
          "reference_code",
          "status"
        ]
      },
      "TrackRequestResponse": {
        "type": "object",
        "properties": {
          "reference_code": {
            "type": "string"
          },
          "letter_type": {
            "type": "string",
            "enum": [
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "L6",
              "L7",
              "L8",
              "L9",
              "L10"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "SUBMITTED",
              "IN_REVIEW",
              "NEEDS_INFO",
              "APPROVED",
              "GENERATED",
              "SENT",
              "REJECTED"
            ]
          },
          "status_label": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "reference_code",
          "letter_type",
          "status",
          "status_label",
          "updated_at"
        ]
      },
      "UploadMultipartBody": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "KTP",
              "KK",
              "other",
              "photo",
              "document"
            ]
          },
          "file": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "kind",
          "file"
        ]
      },
      "UploadResponse": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "file_id",
          "url",
          "mime",
          "size"
        ]
      },
      "BinaryFileResponse": {
        "type": "string",
        "format": "binary"
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Admin login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid login payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Incorrect email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Current admin profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserPublic"
                }
              }
            }
          },
          "401": {
            "description": "Token is invalid or missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service health check",
        "responses": {
          "200": {
            "description": "Service is running normally",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/letter-types": {
      "get": {
        "tags": [
          "Letter Types"
        ],
        "summary": "Available letter types and dynamic form schema",
        "responses": {
          "200": {
            "description": "List of letter types",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LetterTypeListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/requests": {
      "post": {
        "tags": [
          "Requests"
        ],
        "summary": "Create a public letter request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Request created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRequestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/requests/track/{referenceCode}": {
      "get": {
        "tags": [
          "Requests"
        ],
        "summary": "Track request status by reference code",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "referenceCode",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Tracked request status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackRequestResponse"
                }
              }
            }
          },
          "404": {
            "description": "Request not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads": {
      "post": {
        "tags": [
          "Uploads"
        ],
        "summary": "Upload an image or PDF attachment",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadMultipartBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid upload payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads/{fileId}": {
      "get": {
        "tags": [
          "Uploads"
        ],
        "summary": "Fetch a file through a signed URL",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "fileId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "required": true,
            "name": "exp",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "sig",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "File content",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/BinaryFileResponse"
                }
              }
            }
          },
          "403": {
            "description": "Signed file URL is invalid or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
