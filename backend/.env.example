NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://sapa:sapa@localhost:5432/sapa
JWT_SECRET=change-me-in-production
PUBLIC_BASE_URL=http://localhost:8080
EMAIL_PROVIDER_DEFAULT=mailersend
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@gampongblang.id
SMTP_FROM_NAME=Gampong Blang
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=no-reply@gampongblang.id
MAILERSEND_FROM_NAME=Gampong Blang
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_FROM_EMAIL=no-reply@gampongblang.id
MAILGUN_FROM_NAME=Gampong Blang
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=
GMAIL_FROM_NAME=Gampong Blang
DOCS_ENABLED=true

# Development-only: credentials for `npm run db:seed`'s admin user. Falls back
# to admin@gampongblang.id / admin123 when unset AND NODE_ENV != production.
# When NODE_ENV=production, both are REQUIRED — seeding refuses to run without
# them rather than create a known default admin password.
SEED_ADMIN_EMAIL=admin@gampongblang.id
SEED_ADMIN_PASSWORD=admin123
