NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://sapa:sapa@localhost:5432/sapa
JWT_SECRET=change-me-in-production
APP_CONFIG_ENCRYPTION_KEY=change-me-too-or-jwt-secret-is-used
PUBLIC_BASE_URL=http://localhost:8080
DASHBOARD_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
EMAIL_PROVIDER_DEFAULT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=mailpit
SMTP_PASS=mailpit
SMTP_FROM_EMAIL=no-reply@gampongblang.id
SMTP_FROM_NAME=Gampong Blang
MAILERSEND_API_KEY=dev-placeholder
MAILERSEND_FROM_EMAIL=no-reply@gampongblang.id
MAILERSEND_FROM_NAME=Gampong Blang
MAILGUN_API_KEY=dev-placeholder
MAILGUN_DOMAIN=dev.local
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_FROM_EMAIL=no-reply@gampongblang.id
MAILGUN_FROM_NAME=Gampong Blang
GMAIL_USER=dev@gampongblang.id
GMAIL_APP_PASSWORD=dev-placeholder
GMAIL_FROM_EMAIL=dev@gampongblang.id
GMAIL_FROM_NAME=Gampong Blang
# Optional. JSON string for Firebase Admin service account credentials.
# In production, set this or provide Google application-default credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
DOCS_ENABLED=true

# Production domain:
# PUBLIC_BASE_URL=https://gampongblangdigital.com
# DASHBOARD_BASE_URL=https://gampongblangdigital.com
# CORS_ORIGINS=https://gampongblangdigital.com,https://www.gampongblangdigital.com

# Development-only: credentials for `npm run db:seed`'s admin user. Falls back
# to admin@gampongblang.id / admin123 when unset AND NODE_ENV != production.
# When NODE_ENV=production, both are REQUIRED — seeding refuses to run without
# them rather than create a known default admin password.
SEED_ADMIN_EMAIL=admin@gampongblang.id
SEED_ADMIN_PASSWORD=admin123
