NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://sapa:sapa@localhost:5432/sapa
JWT_SECRET=change-me-in-production
PUBLIC_BASE_URL=http://localhost:8080
DOCS_ENABLED=true

# Development-only: credentials for `npm run db:seed`'s admin user. Falls back
# to admin@gampongblang.id / admin123 when unset AND NODE_ENV != production.
# When NODE_ENV=production, both are REQUIRED — seeding refuses to run without
# them rather than create a known default admin password.
SEED_ADMIN_EMAIL=admin@gampongblang.id
SEED_ADMIN_PASSWORD=admin123
