NODE_ENV=test
# Must point at a database whose name ends in "_test" — tests/helpers/assert-test-db.ts
# refuses to run destructive setup (migrations, TRUNCATE) against anything else.
DATABASE_URL=postgresql://sapa:sapa@localhost:5433/sapa_test
JWT_SECRET=test-secret-value
PUBLIC_BASE_URL=http://localhost:8080
DOCS_ENABLED=true
