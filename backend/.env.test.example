NODE_ENV=test
# Must point at a database whose name ends in "_test" — tests/helpers/assert-test-db.ts
# refuses to run destructive setup (migrations, TRUNCATE) against anything else.
# Port 5432 matches docker-compose.yml. If something else already occupies 5432
# on your machine (a native PostgreSQL install is the usual culprit), remap the
# container in an untracked docker-compose.override.yml and change the port here.
DATABASE_URL=postgresql://sapa:sapa@localhost:5432/sapa_test
JWT_SECRET=test-secret-value
PUBLIC_BASE_URL=http://localhost:8080
EMAIL_PROVIDER_DEFAULT=mailersend
SMTP_SECURE=false
DOCS_ENABLED=true
